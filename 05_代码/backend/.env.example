# dw-etl-pipeline 环境变量样例（复制为 .env 后填真实值；.env 已被 .gitignore 忽略）
# 口令占位符需满足 run_sql.py SAFE_SECRET（A-Za-z0-9_@#%+=.-，8~128 位），否则初始化拒绝渲染。

# ---- MySQL 连接 ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=53306
MYSQL_CONNECT_TIMEOUT=10
MYSQL_READ_TIMEOUT=120
MYSQL_WRITE_TIMEOUT=120

# ---- 账号（01_databases.sql 会创建 dw_etl / dw_reader）----
MYSQL_ROOT_PASSWORD=root_pw_change_me_2026
MYSQL_USER=dw_etl
MYSQL_PASSWORD=etl_pw_change_me_2026
MYSQL_READER_PASSWORD=reader_pw_change_me_2026
# 造数账号：默认复用 root（仅本地），生产应另建只写 biz 的账号
MYSQL_SEED_USER=root
MYSQL_SEED_PASSWORD=root_pw_change_me_2026

# ---- 运行环境 ----
APP_ENV=local
